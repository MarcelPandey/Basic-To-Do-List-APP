<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/judulApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="App Gacor 888"
        android:textSize="24sp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textHalo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Halo User!"
        android:textSize="20sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toBottomOf="@+id/judulApp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textSapaan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Apakah sudah siap mengerjakan tugas hari ini?"
        android:textSize="18sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toBottomOf="@+id/textHalo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <EditText
        android:id="@+id/textInput"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:hint="Nama task"
        android:textSize="14sp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSapaan" />

    <Button
        android:id="@+id/btnTanggal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih tanggal"
        android:textSize="14sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintStart_toEndOf="@id/textInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textInput"
        app:layout_constraintBottom_toBottomOf="@id/textInput" />

    <RadioGroup
        android:id="@+id/radioGroup1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/textInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/btnPrioritas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Prioritas"
            />

        <RadioButton
            android:id="@+id/btnMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium"
            />

        <RadioButton
            android:id="@+id/btnChill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Santai"
            />

    </RadioGroup>

    <Button
        android:id="@+id/btnTambah"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tambah +"
        android:textSize="14dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/angkaPrioritas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="24sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnTambah"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/angkaMedium"/>

    <TextView
        android:id="@+id/cardPrioritas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Prioritas"
        android:textSize="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/angkaPrioritas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cardMedium"/>


    <TextView
        android:id="@+id/angkaMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2"
        android:textSize="24sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnTambah"
        app:layout_constraintStart_toEndOf="@id/angkaPrioritas"
        app:layout_constraintEnd_toStartOf="@+id/angkaSantai"/>

    <TextView
        android:id="@+id/cardMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Medium"
        android:textSize="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/angkaMedium"
        app:layout_constraintStart_toEndOf="@id/cardPrioritas"
        app:layout_constraintEnd_toStartOf="@+id/cardSantai"/>

    <TextView
        android:id="@+id/angkaSantai"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="3"
        android:textSize="24sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnTambah"
        app:layout_constraintStart_toEndOf="@id/angkaMedium"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/cardSantai"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Santai"
        android:textSize="20sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/angkaSantai"
        app:layout_constraintStart_toEndOf="@id/cardMedium"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textUnfinished"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Unfinished Task"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardPrioritas"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/textUnderHari"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Dibawah 5 hari"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/textUnfinished"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerUnfinished"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/textUnderHari"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />






</androidx.constraintlayout.widget.ConstraintLayout>
