<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/judulApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="App Gacor 888"
        android:textSize="24sp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textHalo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Halo User!"
        android:textSize="20sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toBottomOf="@+id/judulApp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textSapaan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Apakah sudah siap mengerjakan tugas hari ini?"
        android:textSize="18sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toBottomOf="@+id/textHalo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <EditText
        android:id="@+id/textInput"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:hint="Nama task"
        android:textSize="14sp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSapaan" />

    <Button
        android:id="@+id/btnTanggal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih tanggal"
        android:textSize="14sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintStart_toEndOf="@id/textInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textInput"
        app:layout_constraintBottom_toBottomOf="@id/textInput" />

    <RadioGroup
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/textInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/btnPrioritas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Prioritas"
            />

        <RadioButton
            android:id="@+id/btnMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Medium"
            />

        <RadioButton
            android:id="@+id/btnChill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Santai"
            />

    </RadioGroup>




</androidx.constraintlayout.widget.ConstraintLayout>
